{
    "name": "@ostro/filesystem",
    "version": "2.0.0-alpha.5",
    "description": "filesystem module for OstroJS",
    "main": "build/filesystemManager.js",
    "types": "./build/types/filesystemManager.d.ts",
    "files": [
        "build"
    ],
    "exports": {
        ".": {
            "types": "./build/types/filesystemManager.d.ts",
            "default": "./build/filesystemManager.js"
        },
        "./*": {
            "types": "./build/types/*.d.ts",
            "default": "./build/*.js"
        }
    },
    "scripts": {
        "build": "npm run lint:check && npx tsc -p tsconfig.build.json && node scripts/build.js",
        "prepublishOnly": "npm run build",
        "test": "npx c8 npx jest",
        "clean": "rm -rf build coverage",
        "lint:check": "tsc --noEmit -p tsconfig.build.json"
    },
    "dependencies": {
        "@ostro/contracts": "^2.0.0-alpha.5",
        "@ostro/support": "^2.0.0-alpha.6",
        "filehound": "^1.17.6",
        "fs-extra": "^11.4.1",
        "uuid": "^11.1.1"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "keywords": [
        "filesystem",
        "storage",
        "NodeJS Filesystem",
        "OstroJS Filesystem"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/filesystem.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/filesystem/issues"
    },
    "homepage": "https://github.com/ostrojs/filesystem#readme",
    "devDependencies": {
        "@types/node": "^22.0.0",
        "typescript": "^5.8.0",
        "@types/jest": "^30.0.0",
        "c8": "^10.1.3",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.9.2",
        "@ostro/builder": "^2.0.0-alpha.3"
    },
    "overrides": {
        "sprintf-js": "^1.1.3",
        "braces": "^3.0.3",
        "argparse": "^2.0.1",
        "js-yaml": "^4.1.0"
    }
}
