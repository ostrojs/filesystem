{
    "name": "@ostro/filesystem",
    "version": "2.0.0-alpha.1",
    "description": "filesystem module for OstroJS",
    "main": "build/filesystemManager.js",
    "types": "build/filesystemManager.d.ts",
    "files": [
        "build"
    ],
    "exports": {
        ".": {
            "types": "./build/filesystemManager.d.ts",
            "default": "./build/filesystemManager.js"
        },
        "./*": {
            "types": "./build/*.d.ts",
            "default": "./build/*.js"
        }
    },
    "scripts": {
        "build": "npx tsc -p tsconfig.build.json && node scripts/build.js",
        "prepublishOnly": "npm run build",
        "test": "npx c8 npx jest",
        "clean": "rm -rf build coverage"
    },
    "dependencies": {
        "@ostro/contracts": "^2.0.0-alpha.1",
        "@ostro/support": "^2.0.0-alpha.1",
        "filehound": "^1.17.4",
        "fs-extra": "^11.4.1",
        "lodash.get": "^4.4.2",
        "uuid": "^11.1.1"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "engineStrict": true,
    "keywords": [
        "filesystem",
        "storage",
        "NodeJS Filesystem",
        "OstroJS Filesystem"
    ],
    "author": "amar",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ostrojs/filesystem.git"
    },
    "bugs": {
        "url": "https://github.com/ostrojs/filesystem/issues"
    },
    "homepage": "https://github.com/ostrojs/filesystem#readme",
    "devDependencies": {
        "@types/node": "^22.20.5",
        "typescript": "^5.8.0"
    }
}
